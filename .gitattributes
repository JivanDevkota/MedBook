# Normalize all text files to LF in the repository; Git checks out native endings.
* text=auto

# Shell scripts always LF
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts always CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
